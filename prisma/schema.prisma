// AuPairly — marketplace for families & au pairs
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUPAIR
  PARENT
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  FILLED
}

enum MessageStatus {
  SENT
  READ
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// Peer friendship requests (au pair ↔ au pair community)
enum PeerConnectStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role
  image         String?
  phone         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aupairProfile  AuPairProfile?
  familyProfile  FamilyProfile?
  verifications  Verification[]
  sentMessages   Message[]      @relation("SentMessages")
  conversationsA Conversation[] @relation("UserA")
  conversationsB Conversation[] @relation("UserB")
  favorites      Favorite[]
  reviewsGiven   Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")
  interestsSent     Interest[]  @relation("InterestsSent")
  interestsReceived Interest[]  @relation("InterestsReceived")
  peerConnectsSent     PeerConnect[] @relation("PeerConnectSent")
  peerConnectsReceived PeerConnect[] @relation("PeerConnectReceived")
  blocksInitiated      UserBlock[]   @relation("BlocksFrom")
  blocksReceived       UserBlock[]   @relation("BlocksTo")
  cityHangouts         CityHangout[]
  notifications     Notification[]
  subscription      Subscription?
  swipes            Swipe[]    @relation("SwipesFrom")
  swipesReceived    Swipe[]    @relation("SwipesTo")
  plan            String       @default("FREE") // FREE | PLUS | PREMIUM
  stripeCustomerId String?
  /// Stripe Connect V2 account id (acct_...) for this user as a seller/merchant
  stripeConnectAccountId String? @unique
  /// Platform-level subscription status for the connected account (seller plan)
  connectSubscriptionStatus String? // active | trialing | past_due | canceled | none
  connectSubscriptionId     String?

  /// Trust / placement product fields
  videoIntroUrl       String?
  /// Self-declared or measured intro video length (seconds). Applications require ≥ 60.
  videoIntroSeconds   Int?
  /// User confirmed intro is at least 1 minute (required with video for applications)
  videoIntroConfirmed Boolean  @default(false)
  /// Public CV / resume URL (PDF or drive link) — filterable sitter field
  cvUrl               String?
  placementVerified   Boolean  @default(false)
  safetyScore         Int      @default(50) // 0–100, recomputed from signals
  agencyId            String?
  agency              Agency?  @relation(fields: [agencyId], references: [id])
  locale              String   @default("en")
  /// Median-ish response time in minutes (updated when replying to messages)
  avgResponseMinutes  Int?
  lastActiveAt        DateTime?
  /// Last successful credentials login (management login monitoring)
  lastLoginAt         DateTime?
  /// Total successful logins (approx)
  loginCount          Int      @default(0)
  /// Last re-engagement email day-bucket sent (3 | 7 | 14 | 30)
  lastReengageDay     Int?
  lastReengageAt      DateTime?
  /// Partner / co-parent seat: linked secondary account
  householdOwnerId    String?
  householdOwner      User?    @relation("Household", fields: [householdOwnerId], references: [id])
  householdMembers    User[]   @relation("Household")
  partnerInviteToken  String?  @unique

  /// Who invited this user (register?ref=…)
  referredById        String?
  referredBy          User?    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]   @relation("UserReferrals")
  /// Referral reward already applied for the inviter (one-time per invitee)
  referralRewardGranted Boolean @default(false)

  placementsAsParent  Placement[] @relation("PlacementParent")
  placementsAsAupair  Placement[] @relation("PlacementAupair")
  referencesRequested ReferenceRequest[] @relation("RefsRequested")
  referencesAbout     ReferenceRequest[] @relation("RefsAbout")
  documents           SecureDocument[]
  supportTickets      SupportTicket[]
  stories             Story[]
  savedSearches       SavedSearch[]
  availabilitySlots   AvailabilitySlot[]
  shortlistItems      ShortlistItem[] @relation("ShortlistOwner")
  shortlistedBy       ShortlistItem[] @relation("ShortlistTarget")
  applicationsSent    ApplicationPacket[] @relation("AppsSent")
  applicationsReceived ApplicationPacket[] @relation("AppsReceived")
  interviewProposals  InterviewProposal[] @relation("InterviewFrom")
  boostEvents         BoostEvent[]
  pushSubscriptions   PushSubscription[]
  paymentTransactions PaymentTransaction[]
  loginSessions       LoginSession[]

  /// External identity / social
  facebookId          String?  @unique
  /// JSON: name, picture, link, email (from Facebook Login — not KYC)
  facebookProfile     String?
  /// Last 4 of national ID only (privacy); full ID never stored long-term
  idNumberLast4       String?
  /// verifynow | didit | manual | demo
  kycProvider         String?
  kycExternalId       String?
  kycVerifiedAt       DateTime?
  /// ISO country that drove the KYC path (ZA → VerifyNow, else international)
  kycCountry          String?

  /// Admin moderation — blocks login/messaging when set
  suspendedAt         DateTime?
  suspendReason       String?

  /// Email preference for transactional alerts: INSTANT | DAILY | OFF
  emailPrefMessages   String   @default("INSTANT")
  /// Opt-in WhatsApp-style phone alerts (uses phone field when true)
  whatsappAlerts      Boolean  @default(false)
}

/// Last successful cron runs (ops health on /manage)
model CronRun {
  id        String   @id @default(cuid())
  job       String   @unique // alerts | activation | match-digest | expire-plans | reengage
  lastRunAt DateTime @default(now())
  ok        Boolean  @default(true)
  meta      String?  // optional JSON summary
  updatedAt DateTime @updatedAt
}

/// Login / session tracking for management monitoring
model LoginSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  /// Seconds active (lastSeenAt - startedAt), set on end or read live
  durationSec Int?
  userAgent   String?
  ip          String?

  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([endedAt])
}

/// Product funnel events (signup → publish → message → pay)
model FunnelEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  role      String?
  props     String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([createdAt])
  @@index([userId])
}

model AuPairProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline        String?
  bio             String?
  nationality     String?
  languages       String        @default("[]") // JSON array
  age             Int?
  gender          String?
  experienceYears Int           @default(0)
  childcareSkills String        @default("[]") // JSON array
  education       String?
  /// NOT_STUDYING | STUDYING | COMPLETED
  studyStatus     String?
  /// e.g. "BEd Foundation Phase", "ECD NQF 4"
  studyingTowards String?
  /// JSON: [{ id, title, institution?, year?, status: COMPLETED|IN_PROGRESS|PLANNED, documentUrl? }]
  qualifications  String        @default("[]")
  drivingLicense  Boolean       @default(false)
  firstAid        Boolean       @default(false)
  swimming        Boolean       @default(false)
  nonSmoker       Boolean       @default(true)

  preferredCountries String    @default("[]") // JSON
  availableFrom   DateTime?
  availableTo     DateTime?
  durationMonths  Int?
  weeklyHours     Int?
  pocketMoneyMin  Int?
  liveIn          Boolean       @default(true)
  /// Recurring weekly availability: days + start/end times (JSON)
  scheduleJson    String?
  /// Marketplace services offered (JSON array of ServiceCategory ids)
  /// CHILDCARE | CAREGIVING | HOUSE_SITTING | PET_SITTING
  services        String        @default("[\"CHILDCARE\"]")
  /// Pet types comfortable with (JSON) when PET_SITTING
  petTypes        String        @default("[]")
  /// House-sitting experience / notes
  houseSittingNotes String?
  /// Caregiving / childcare focus chips (JSON)
  careFocus       String        @default("[]")

  city            String?
  /// Province / state / region
  region          String?
  country         String?
  /// AF | AS | EU | NA | SA | OC | AN
  continent       String?
  coverImage      String?
  photos          String        @default("[]") // JSON
  /// Work / relocation readiness
  workRights      String?       // CITIZEN | PERMIT | SEEKING | UNKNOWN
  willingRelocate Boolean       @default(false)
  relocateCities  String        @default("[]") // JSON
  certificates    String        @default("[]") // JSON labels e.g. First aid cert

  /// AuPair Connect: visible to other sitters looking for local friends
  openToPeerConnect Boolean     @default(true)
  /// Short blurb for community (e.g. “new in Cape Town, love coffee & weekend hikes”)
  peerIntro       String?

  status          ListingStatus @default(DRAFT)
  isVerified      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  boostedUntil    DateTime?
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  responseRate    Int           @default(100)
  /// Profile views while boosted (analytics)
  boostViews      Int           @default(0)
  boostLikes      Int           @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([continent])
  @@index([country])
  @@index([region])
  @@index([city])
  @@index([services])
  @@index([status, services])
  @@index([openToPeerConnect, status, city])
}

model FamilyProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline        String?
  bio             String?
  familyName      String?
  city            String?
  /// Province / state / region
  region          String?
  country         String?
  /// AF | AS | EU | NA | SA | OC | AN
  continent       String?
  addressArea     String?       // neighborhood only for privacy

  childrenCount   Int           @default(1)
  childrenAges    String        @default("[]") // JSON ages
  childrenDetails String?

  languages       String        @default("[]")
  preferences     String?       // what they look for in an au pair
  duties          String        @default("[]") // JSON
  offers          String        @default("[]") // room, meals, language lessons etc.

  startDate       DateTime?
  /// Optional end / through date for the placement window
  endDate         DateTime?
  durationMonths  Int?
  weeklyHours     Int?
  pocketMoney     Int?
  /// Free-text pay & benefits (meals, transport, data, gym, etc.)
  benefits        String?
  /// What the job entails (role brief beyond duties chips)
  jobEntails      String?
  /// Visa / passport support for sitters: NONE | HELP | SPONSOR | CITIZEN_ONLY
  visaSupport     String?
  liveIn          Boolean       @default(true)
  hasPets         Boolean       @default(false)
  petDetails      String?
  ownRoom         Boolean       @default(true)
  carProvided     Boolean       @default(false)
  /// School-run / location filters
  schoolArea      String?
  drivingRequired Boolean       @default(false)
  /// Lifestyle / home preview captions (photos JSON already holds URLs)
  lifestyleNotes  String?
  /// Recurring au pair schedule: days, hours, weekly/alternating pattern (JSON)
  scheduleJson    String?
  /// Services needed (JSON array of ServiceCategory ids)
  services        String        @default("[\"CHILDCARE\"]")
  /// Pets to care for (JSON) when PET_SITTING
  petTypes        String        @default("[]")
  /// House-sitting specific notes (alarms, plants, dates)
  houseSittingNotes String?
  /// House swap (mutual exchange) — when services includes HOUSE_SWAP
  /// Window you can offer your home / travel
  swapAvailableFrom DateTime?
  swapAvailableTo   DateTime?
  /// Destinations / regions you want to swap into (JSON string array)
  swapSeekingAreas  String      @default("[]")
  /// Beds, guests, home style for swap matches
  swapHomeSummary   String?
  /// Simultaneous exchange vs non-simultaneous / points-style later
  swapSimultaneous  Boolean     @default(true)
  /// Caregiving / childcare focus chips (JSON)
  careFocus       String        @default("[]")

  coverImage      String?
  photos          String        @default("[]")

  status          ListingStatus @default(DRAFT)
  isVerified      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  boostedUntil    DateTime?
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  boostViews      Int           @default(0)
  boostLikes      Int           @default(0)
  /// Host: urgent need badge (paid or manual)
  isUrgent        Boolean       @default(false)
  urgentUntil     DateTime?
  /// Cities/areas where care is needed (JSON string array) — multi-location
  preferredAreas  String        @default("[]")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([continent])
  @@index([country])
  @@index([region])
  @@index([city])
  @@index([services])
  @@index([status, services])
  @@index([isUrgent, status])
}

/// Block / mute another user (messages, discover, connect)
model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    User     @relation("BlocksFrom", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("BlocksTo", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// AuPair Connect — lightweight city hangout / tip posts
model CityHangout {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  city      String
  country   String?
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([city, country, createdAt])
  @@index([authorId])
}

/// Catalog of marketplace categories (seeded; stable IDs)
model ServiceCategory {
  id          String   @id // CHILDCARE | CAREGIVING | HOUSE_SITTING | PET_SITTING
  name        String
  shortName   String
  slug        String   @unique
  description String?
  examples    String   @default("[]") // JSON
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        ProfileServiceTag[]
}

/// Normalized service tags for reliable filtering (synced from profile.services JSON)
model ProfileServiceTag {
  id          String   @id @default(cuid())
  /// AUPAIR (sitter) | FAMILY (host)
  profileRole String
  /// AuPairProfile.id or FamilyProfile.id
  profileId   String
  serviceId   String
  service     ServiceCategory @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([profileRole, profileId, serviceId])
  @@index([serviceId])
  @@index([profileId])
  @@index([profileRole, serviceId])
}

model Verification {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String             // ID, BACKGROUND, ADDRESS, REFERENCES, SELFIE
  status      VerificationStatus @default(PENDING)
  documentUrl String?
  notes       String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
}

model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  userA         User      @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())

  @@index([conversationId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // AUPAIR | FAMILY
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

/// Star + written reviews: owner-moderated before public release
model Review {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId   String
  target     User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  /// Overall 1–5 (required)
  rating     Int
  /// Category scores 1–5 (Airbnb-style)
  communication Int?
  reliability   Int?
  respect       Int?
  recommend     Boolean @default(true)
  comment    String?
  /// Never shown to the other party — platform only
  privateNote String?
  /// Public reply from the reviewed party
  response    String?
  respondedAt DateTime?
  /// When this review becomes public (set when app owner approves)
  publishedAt DateTime?
  /// PENDING | APPROVED | REJECTED — only APPROVED + publishedAt is public
  moderationStatus String @default("PENDING")
  moderatedAt      DateTime?
  /// MESSAGE | PLACEMENT | MATCH
  context     String   @default("MESSAGE")
  placementId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([authorId, targetId])
  @@index([targetId, publishedAt])
  @@index([authorId, createdAt])
  @@index([moderationStatus, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetId   String
  reason     String
  details    String?
  status     String   @default("OPEN") // OPEN | REVIEWED | DISMISSED
  createdAt  DateTime @default(now())

  @@index([status])
}

/// Express interest / apply between parent and au pair
model Interest {
  id          String         @id @default(cuid())
  fromUserId  String
  fromUser    User           @relation("InterestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User           @relation("InterestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String?
  status      InterestStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId])
}

/// AuPair Connect — peer friendship between sitters (not host matching)
model PeerConnect {
  id          String            @id @default(cuid())
  fromUserId  String
  fromUser    User              @relation("PeerConnectSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User              @relation("PeerConnectReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String?
  status      PeerConnectStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // MESSAGE | INTEREST | INTEREST_UPDATE | SYSTEM | REVIEW | MATCH | BILLING
  title     String
  body      String
  href      String?
  readAt    DateTime?
  meta      String?  // optional JSON
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Subscription / membership (freemium + paid access)
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    // FREE | PLUS | PREMIUM
  status               String    @default("ACTIVE") // ACTIVE | CANCELED | PAST_DUE | TRIALING
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// Discover swipe
model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SwipesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("SwipesTo", fields: [toUserId], references: [id], onDelete: Cascade)
  direction  String   // LIKE | PASS | SUPER
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([fromUserId, createdAt])
}

/// Track daily usage for free-tier limits
model UsageCounter {
  id        String   @id @default(cuid())
  userId    String
  action    String   // MESSAGE | INTEREST | SWIPE | BOOST
  dayKey    String   // YYYY-MM-DD UTC
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, action, dayKey])
  @@index([userId, dayKey])
}

/// Seller catalog for Paystack storefront (SA marketplace)
model MarketplaceProduct {
  id          String   @id @default(cuid())
  sellerUserId String
  name        String
  description String?
  /// Amount in cents (ZAR)
  amountCents Int
  currency    String   @default("ZAR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerUserId, active])
}

/// Placement pipeline: Interested → Interview → Trial → Placed → Completed
model Placement {
  id           String   @id @default(cuid())
  parentUserId String
  parent       User     @relation("PlacementParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  aupairUserId String
  aupair       User     @relation("PlacementAupair", fields: [aupairUserId], references: [id], onDelete: Cascade)
  /// INTERESTED | INTERVIEW | TRIAL | PLACED | COMPLETED | CANCELLED
  status       String   @default("INTERESTED")
  checklist    String   @default("{}") // JSON: dates, pocketMoney, duties, room, visa
  interviewAt  DateTime?
  interviewNotes String?
  trialStart   DateTime?
  trialEnd     DateTime?
  trialNotes   String?
  placedAt     DateTime?
  completedAt  DateTime?
  /// Success fee payment
  successFeeCents   Int      @default(250000) // R2500 default
  successFeePaidAt  DateTime?
  successFeeRef     String?
  contractText      String?
  /// Structured offer letter (JSON) accepted by both parties
  offerJson         String?
  offerAcceptedParentAt  DateTime?
  offerAcceptedAupairAt  DateTime?
  trialFeedback     String?  // JSON after trial
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checkIns     PlacementCheckIn[]

  @@unique([parentUserId, aupairUserId])
  @@index([parentUserId, status])
  @@index([aupairUserId, status])
}

/// Reference request (email token → public form)
model ReferenceRequest {
  id            String    @id @default(cuid())
  requesterId   String
  requester     User      @relation("RefsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       User      @relation("RefsAbout", fields: [subjectId], references: [id], onDelete: Cascade)
  refereeEmail  String
  refereeName   String?
  token         String    @unique
  status        String    @default("PENDING") // PENDING | SUBMITTED | EXPIRED
  rating        Int?
  comment       String?
  relationship  String?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([subjectId, status])
  @@index([token])
}

/// Private document vault (passport, clearance, first aid, CV…)
/// File URLs are never shown on public profiles — only the member + app owners can open them.
model SecureDocument {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String    // PASSPORT | POLICE | FIRST_AID | VISA | CV | QUALIFICATION | OTHER
  label      String?
  url        String
  expiresAt  DateTime?
  /// Always true for certs: only app owners (management) may view others' vault files
  ownerOnly  Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([type])
}

/// Short “available from” stories / status
model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/// Agency (B2B) manages multiple au pairs
model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  plan      String   @default("STARTER") // STARTER | PRO
  branding  String?  // logo URL
  createdAt DateTime @default(now())
  members   User[]
}

/// In-app support for paid users
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  status    String   @default("OPEN") // OPEN | REPLIED | CLOSED
  reply     String?
  /// Premium SLA target hours
  slaHours  Int      @default(48)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// Saved search + email/push-style alerts
model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// JSON filters: city, country, verified, driving, liveIn, q, role target
  filters       String    @default("{}")
  alertEnabled  Boolean   @default(true)
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

/// Availability / need-cover calendar blocks
model AvailabilitySlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FREE | BUSY | NEED_COVER
  kind      String   @default("FREE")
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, startDate])
}

/// Family shortlist for comparing au pairs (or vice versa)
model ShortlistItem {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("ShortlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId    String
  targetUser      User     @relation("ShortlistTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetProfileId String?
  targetType      String   // AUPAIR | FAMILY
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([userId, targetUserId])
  @@index([userId])
}

/// One-tap application packet (video + refs + docs + intro)
model ApplicationPacket {
  id           String   @id @default(cuid())
  fromUserId   String
  fromUser     User     @relation("AppsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User     @relation("AppsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  message      String?
  /// Snapshot JSON: videoUrl, docs[], refs[], headline, safetyScore
  packetJson   String   @default("{}")
  status       String   @default("SENT") // SENT | VIEWED | ACCEPTED | DECLINED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId])
}

/// Propose interview times in chat
model InterviewProposal {
  id             String    @id @default(cuid())
  conversationId String
  fromUserId     String
  fromUser       User      @relation("InterviewFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  proposedAt     DateTime
  durationMin    Int       @default(30)
  note           String?
  meetingUrl     String?
  status         String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([conversationId])
  @@index([fromUserId])
}

/// Day 7 / day 30 placement check-ins
model PlacementCheckIn {
  id          String    @id @default(cuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  dayOffset   Int       // 7 | 30
  sentAt      DateTime  @default(now())
  response    String?
  rating      Int?
  respondedAt DateTime?

  @@unique([placementId, dayOffset])
  @@index([placementId])
}

/// Boost purchase analytics window
model BoostEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  endsAt    DateTime
  views     Int      @default(0)
  likes     Int      @default(0)
  messages  Int      @default(0)

  @@index([userId, endsAt])
}

/// Payment / billing ledger for the user account report
model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// MEMBERSHIP | BOOST | SUCCESS_FEE | MARKETPLACE | DEMO | OTHER
  kind        String
  /// SUCCESS | PENDING | FAILED | REFUNDED
  status      String   @default("SUCCESS")
  amountCents Int
  currency    String   @default("ZAR")
  description String
  /// Paystack / Stripe external reference (unique when present)
  reference   String?  @unique
  /// paystack | demo | stripe
  provider    String   @default("paystack")
  /// Optional JSON extras (planId, period, productId, placementId, …)
  meta        String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, paidAt])
  @@index([userId, kind])
}

/// City launch waitlist (email capture when local supply is thin)
model CityWaitlist {
  id        String   @id @default(cuid())
  email     String
  city      String
  slug      String?
  role      String? // PARENT | AUPAIR | BOTH
  createdAt DateTime @default(now())

  @@unique([email, city])
  @@index([slug])
  @@index([createdAt])
}

/// Web Push subscriptions (PWA notifications)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
