{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "npm install",

  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/match-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "0 9 * * *"
    }
  ]
}
