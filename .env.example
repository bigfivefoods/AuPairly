# ── Supabase Postgres ─────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string
#
# 1) Transaction pooler (app runtime / Vercel serverless) — port 6543
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# 2) Direct connection (Prisma migrations) — port 5432
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Tip: In Supabase UI pick "URI" and Mode "Transaction" for DATABASE_URL,
# and Mode "Session" or "Direct" for DIRECT_URL.
# If your password has special characters, URL-encode them.

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Public site (production: https://www.aupairly.me)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AuPairly"

# Verification: auto-approve checks (true for demos). Set false for admin queue.
AUTO_VERIFY="true"

# Email (Resend) — welcome, messages, interests
# RESEND_API_KEY="re_..."
# EMAIL_FROM="AuPairly <noreply@aupairly.me>"


# Supabase API (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional server-only (never commit / never NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY="..."   # required for Supabase Storage uploads
# SUPABASE_STORAGE_BUCKET="aupairly"

# Stripe (optional — without keys, upgrades run in 30-day demo mode)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS_PARENT=price_...
# STRIPE_PRICE_PLUS_AUPAIR=price_...
# STRIPE_PRICE_PREMIUM_PARENT=price_...
# STRIPE_PRICE_PREMIUM_AUPAIR=price_...

# ── Stripe (legacy / optional — Paystack is primary for SA) ─────────────────────────────────────────
# Secret key (required for any Stripe call)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Classic webhooks (subscriptions / checkout) → /api/connect/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Thin event destination (V2 account requirements) → same or separate endpoint
# STRIPE_THIN_WEBHOOK_SECRET=whsec_...
#
# Platform subscription price charged TO connected accounts (seller plan)
# STRIPE_CONNECT_PLATFORM_PRICE_ID=price_...
#
# Application fee on direct charges, in basis points (250 = 2.5%)
# STRIPE_APPLICATION_FEE_BPS=250

# ── Paystack (South Africa — primary payments) ────────────────────
# https://dashboard.paystack.com/#/settings/developers
# PAYSTACK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_CURRENCY=ZAR
# Optional recurring plan codes from Paystack Dashboard → Plans
# PAYSTACK_PLAN_PLUS_PARENT=PLN_...
# PAYSTACK_PLAN_PLUS_AUPAIR=PLN_...
# PAYSTACK_PLAN_PREMIUM_PARENT=PLN_...
# PAYSTACK_PLAN_PREMIUM_AUPAIR=PLN_...
# Webhook URL: https://www.aupairly.me/api/billing/webhook

# Weekly match digest cron (Vercel Cron Mon 08:00 UTC → /api/cron/match-digest)
# CRON_SECRET=long-random-string
# RESEND_API_KEY=re_...   # required to actually send digests
# EMAIL_FROM="AuPairly <noreply@aupairly.me>"

# ── Web Push (PWA notifications) ─────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:hello@aupairly.me
