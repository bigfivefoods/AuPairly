# ── Database: Supabase Postgres ONLY ──────────────────────────────
# Do not set POSTGRES_URL / Neon / Prisma Postgres / SQLite — unsupported.
# Dashboard → Project Settings → Database → Connection string → URI
#
# 1) Transaction pooler (app runtime / Vercel serverless) — port 6543
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# 2) Session or Direct (Prisma migrations) — port 5432
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Mode "Transaction" → DATABASE_URL; Mode "Session" or "Direct" → DIRECT_URL.
# URL-encode special characters in the password.

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Privy — email OTP before registration (https://dashboard.privy.io)
# Enable Login method: Email. Copy App ID + App Secret.
NEXT_PUBLIC_PRIVY_APP_ID=""
# Optional app client id
# NEXT_PUBLIC_PRIVY_CLIENT_ID=""
PRIVY_APP_SECRET=""
# Optional: verification key from Privy Dashboard → Configuration → App settings
# PRIVY_VERIFICATION_KEY=""
# Set to "false" only for local demos without Privy (not recommended)
# PRIVY_EMAIL_VERIFY_REQUIRED="true"

# Public site (production: https://www.aupairly.me)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AuPairly"

# Verification: auto-approve checks. Use true only for demos/dev.
# Production must be false so admins review ID/selfie in /admin.
AUTO_VERIFY="false"

# ── VerifyNow fee (Paystack) — Free plan only ─────────────────────
# Plus/Premium members: always free. Free plan default R10.00
# KYC_VERIFYNOW_FEE_CENTS="1000"

# ── VerifyNow (South Africa KYC) ──────────────────────────────────
# Docs: https://www.verifynow.co.za/api-docs
# Base: https://www.verifynow.co.za/api/external
# Header: x-api-key: vn_live_...  (never expose client-side)
# Production requires Idempotency-Key; sandbox costs 0 credits.
# Marketplace flow uses Standard KYC Bundle + Face Match.
# VERIFYNOW_API_KEY="vn_live_..."          # required for live Home Affairs checks
# VERIFYNOW_MODE="production"              # production | sandbox (vn_live_ defaults to production)
# VERIFYNOW_ALLOW_DEMO="false"             # never silent-demo on Vercel/production
# VERIFYNOW_API_BASE="https://www.verifynow.co.za/api/external"

# ── Didit (international ID + liveness) ───────────────────────────
# Setup guide: DIDIT.md — hosted verification for non-SA IDs
# https://docs.didit.me  ·  Console: https://business.didit.me
# DIDIT_API_KEY="..."
# DIDIT_WORKFLOW_ID="..."      # published KYC workflow UUID (required)
# DIDIT_WEBHOOK_SECRET="..."   # destination secret_shared_key
# Webhook URL: {SITE_URL}/api/verification/kyc/webhook
# DIDIT_API_BASE="https://verification.didit.me/v3"

# ── Meta / Facebook Login (profile import only — NOT KYC) ─────────
# Setup guide: META.md
# Valid OAuth redirect: {SITE_URL}/api/social/facebook/callback
# NEXT_PUBLIC_FACEBOOK_APP_ID=""   # Meta App ID (public)
# AUTH_FACEBOOK_SECRET=""          # Meta App Secret (server only)
# AUTH_FACEBOOK_ID=""              # optional alias for App ID
# FACEBOOK_APP_SECRET=""           # optional alias for secret

# Email (Resend) — welcome, messages, interests, digests, day-1 activation
# RESEND_API_KEY="re_..."
# EMAIL_FROM="noreply@aupairly.me"

# Cron auth (Vercel Cron Authorization: Bearer …)
# CRON_SECRET="long-random-string"

# Analytics (optional)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="www.aupairly.me"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXX"
# GOOGLE_SITE_VERIFICATION=""

# Extra management console emails (comma-separated). Owner craig@bigfivegroup.africa is always allowed.
# MANAGEMENT_EMAILS="you@example.com"

# Production: set false so ID/selfie need admin review
# AUTO_VERIFY="false"

# Paystack LIVE for real ZAR (test keys blocked on Vercel production unless ALLOW_TEST)
# PAYSTACK_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_ALLOW_TEST=false
# Webhook: https://www.aupairly.me/api/billing/webhook

# Optional monitoring
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.aupairly.me
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX


# Supabase API (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional server-only (never commit / never NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY="..."   # required for Supabase Storage uploads
# SUPABASE_STORAGE_BUCKET="aupairly"

# Stripe (optional — without keys, upgrades run in 30-day demo mode)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS_PARENT=price_...
# STRIPE_PRICE_PLUS_AUPAIR=price_...
# STRIPE_PRICE_PREMIUM_PARENT=price_...
# STRIPE_PRICE_PREMIUM_AUPAIR=price_...

# ── Stripe (legacy / optional — Paystack is primary for SA) ─────────────────────────────────────────
# Secret key (required for any Stripe call)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Classic webhooks (subscriptions / checkout) → /api/connect/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Thin event destination (V2 account requirements) → same or separate endpoint
# STRIPE_THIN_WEBHOOK_SECRET=whsec_...
#
# Platform subscription price charged TO connected accounts (seller plan)
# STRIPE_CONNECT_PLATFORM_PRICE_ID=price_...
#
# Application fee on direct charges, in basis points (250 = 2.5%)
# STRIPE_APPLICATION_FEE_BPS=250

# ── Paystack (South Africa — primary payments) ────────────────────
# https://dashboard.paystack.com/#/settings/developers
# PAYSTACK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_CURRENCY=ZAR
# Optional recurring plan codes from Paystack Dashboard → Plans
# PAYSTACK_PLAN_PLUS_PARENT=PLN_...
# PAYSTACK_PLAN_PLUS_AUPAIR=PLN_...
# PAYSTACK_PLAN_PREMIUM_PARENT=PLN_...
# PAYSTACK_PLAN_PREMIUM_AUPAIR=PLN_...
# Webhook URL: https://www.aupairly.me/api/billing/webhook

# Weekly match digest cron (Vercel Cron Mon 08:00 UTC → /api/cron/match-digest)
# CRON_SECRET=long-random-string
# RESEND_API_KEY=re_...   # required to actually send digests
# EMAIL_FROM="noreply@aupairly.me"

# ── Web Push (PWA notifications) ─────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:hello@aupairly.me
