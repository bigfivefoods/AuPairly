# PostgreSQL connection string (Neon, Supabase, Prisma Postgres, Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Public site (production: https://www.aupairly.me)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AuPairly"

# Verification: auto-approve checks (true for demos). Set false for admin queue.
AUTO_VERIFY="true"

# Optional: real email via Resend
# RESEND_API_KEY="re_..."
# EMAIL_FROM="AuPairly <noreply@aupairly.me>"
